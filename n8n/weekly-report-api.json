    {
      "parameters": {
        "jsCode": "const { weekStart, weekEnd } = $('Validate week').first().json;\nconst count = (node) => {\n  const data = $(node).first().json;\n  if (data.incomplete_results || !Number.isSafeInteger(data.total_count)) {\n    throw new Error('GitHub returned incomplete statistics');\n  }\n  return data.total_count;\n};\n\nconst counts = {\n  openedIssues: count('Opened issues'),\n  closedIssues: count('Closed issues'),\n  openedPrs: count('Opened PRs'),\n  mergedPrs: count('Merged PRs'),\n};\nconst items = $('Opened issues').first().json.items;\nif (!Array.isArray(items) || items.length !== counts.openedIssues) {\n  throw new Error('Issue breakdown exceeds the page size or GitHub returned incomplete data');\n}\n\nconst previous = {\n  openedIssues: count('Previous opened issues'),\n  closedIssues: count('Previous closed issues'),\n  openedPrs: count('Previous opened PRs'),\n  mergedPrs: count('Previous merged PRs'),\n};\nconst comparison = Object.fromEntries(Object.keys(counts).map((key) => [key, counts[key] - previous[key]]));\nconst types = new Map();\nconst authors = new Map();\nconst increment = (map, key) => map.set(key, (map.get(key) ?? 0) + 1);\nfor (const issue of items) {\n  const labels = new Set(issue.labels.map((label) => label.name.toLowerCase()));\n  const type = ['bug', 'task', 'feature', 'feature-request'].find((label) => labels.has(label)) ?? 'unknown';\n  increment(types, type === 'feature-request' ? 'feature' : type);\n  increment(authors, issue.user?.login ?? 'unknown');\n}\nconst breakdown = (map) => [...map].sort(([a], [b]) => a.localeCompare(b)).map(([label, count]) => ({ label, count }));\nreturn [{ json: { weekStart, weekEnd, counts, byType: breakdown(types), byAuthor: breakdown(authors), comparison } }];"
      },
