    {
      "parameters": {
        "jsCode": "const weekStart = $input.first().json.query?.weekStart;\nconst date = new Date(typeof weekStart === 'string' ? weekStart + 'T00:00:00Z' : NaN);\nconst valid = typeof weekStart === 'string'\n  && /^\\d{4}-\\d{2}-\\d{2}$/.test(weekStart)\n  && Number.isFinite(date.getTime())\n  && date.toISOString().slice(0, 10) === weekStart\n  && date.getUTCDay() === 1\n  && date.getUTCFullYear() >= 2008\n  && date.getUTCFullYear() <= 9998;\nif (!valid) return [{ json: { valid, error: 'weekStart must be a Monday (YYYY-MM-DD)' } }];\n\nconst offset = (days) => new Date(date.getTime() + days * 86400000).toISOString().slice(0, 10);\nreturn [{ json: {\n  valid,\n  weekStart,\n  weekEnd: offset(6),\n  current: weekStart + '..' + offset(6),\n  previous: offset(-7) + '..' + offset(-1)\n} }];"
      },
